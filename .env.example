# Mixpanel Analytics Configuration
EXPO_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_project_token_here

# RevenueCat — PUBLIC SDK keys only (appl_/goog_ for the real stores, test_ for
# the RevenueCat Test Store). These ship in the client bundle by design.
# NEVER put a RevenueCat *secret* key (sk_...) in this file or any client env.
# Real App Store public key — used for device Apple sandbox AND production.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_ios_public_sdk_key_here
# Real Play Store public key.
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=goog_your_android_public_sdk_key_here
# RevenueCat Test Store key — used ONLY when EXPO_PUBLIC_REVENUECAT_USE_TEST_STORE=true.
EXPO_PUBLIC_REVENUECAT_IOS_TEST_STORE_KEY=test_your_test_store_key_here
# Set to "true" to develop against the RevenueCat Test Store (e.g. iOS simulator,
# which has no real StoreKit). Ignored in production builds. Default: false.
EXPO_PUBLIC_REVENUECAT_USE_TEST_STORE=false