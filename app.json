{
  "expo": {
    "name": "MastersFit",
    "slug": "mastersfit",
    "version": "1.2.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/baddaaa3-3d1e-46e5-b15a-f5b8a46ded71",
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mastersfit.ai",
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#0A0A0A"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "MastersFit needs access to your health data including steps, heart rate, workout sessions, calories burned, and nutrition to provide personalized fitness insights and track your progress.",
        "NSHealthUpdateUsageDescription": "MastersFit saves your completed workouts to Apple Health so they appear in the Fitness app and count toward your activity.",
        "NSPhotoLibraryUsageDescription": "MastersFit accesses only the photos you explicitly select, such as when adding a picture to your profile.",
        "NSPhotoLibraryAddUsageDescription": "MastersFit saves the workout card you choose to share to your photo library."
      }
    },
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#ffffff",
      "iosDisplayInForeground": true
    },
    "android": {
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#0A0A0A"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.mastersfit.ai",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_EXERCISE_SESSION",
        "android.permission.health.READ_NUTRITION",
        "android.permission.health.WRITE_EXERCISE_SESSION"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "com.google.android.gms.permission.AD_ID"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "scheme": "masters-fit",
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-health-connect",
      "expo-notifications",
      [
        "@jamsch/expo-speech-recognition",
        {
          "microphonePermission": "MastersFit uses the microphone so you can dictate workout notes and feedback instead of typing.",
          "speechRecognitionPermission": "MastersFit uses speech recognition to turn what you say into text for your workout notes and feedback."
        }
      ],
      [
        "react-native-health",
        {
          "healthSharePermission": "MastersFit reads your health data including steps, heart rate, workouts, calories, and nutrition to provide personalized fitness insights.",
          "healthUpdatePermission": "MastersFit saves your completed workouts to Apple Health so they appear in the Fitness app and count toward your activity.",
          "isClinicalDataEnabled": false
        }
      ],
      "./plugins/healthconnect",
      "./plugins/healthkit",
      "./plugins/withRemoveAdId",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "mastersfit-llc",
          "project": "mastersfit-frontend"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "baddaaa3-3d1e-46e5-b15a-f5b8a46ded71"
      }
    },
    "owner": "mastersfit"
  }
}
